# knodo 本地测试环境变量模板
# 复制为 .env 并填值: cp .env.example .env
#
# ============================================================
# 你只需要填 KNODO_INSTALL_URL 一个
# ============================================================
# 容器首次启动时, entrypoint 会调这个 URL 激活, 然后把
# BACKEND_WS_URL + API_TOKEN 自动写到 named volume 里
# (knodo-data:/home/workspace/.knodo/agent/config/agent.env)。
# 后续重启自动复用, 不再需要 install URL。
#
# 拿 URL: 登录 knodo web UI -> 本地执行机 -> 复制安装命令里的 URL
# (24h 有效, 用一次即可)
KNODO_INSTALL_URL=https://anchnet.knodo.vip/api/v1/public/install/local/<YOUR_TOKEN>?origin=https%3A%2F%2Fanchnet.knodo.vip

# ============================================================
# 备份 (激活成功后建议保存, 见 scripts/extract-knodo-credentials.sh)
# ============================================================
# 跑 ./scripts/extract-knodo-credentials.sh --write-backup 自动写下面这俩
# BACKEND_WS_URL=
# API_TOKEN=

# ============================================================
# Traefik 路由 (容器加 labels 引用这个)
# ============================================================
# 域名要在 DNSPod 加 A 记录 (建议加泛域名 *.localdev 一次到位)
# 这里填具体子域名, Traefik 启动后自动发现 + 自动申请 cert
NJS_KNODO_HOST=njs-knodo.localdev.anspire.cn

# ============================================================
# 可选
# ============================================================

# 主机端口 (默认 3001/9911, 错开 python-knodo 的 3000/9910)
# 同时跑两个变体时建议保留默认值
# 想跟 python-knodo 共用端口 (会冲突), 改:
# OVSS_HOST_PORT=3000
# KNODO_HOST_PORT=9910
OVSS_HOST_PORT=3001
KNODO_HOST_PORT=9911

# 项目目录 (daemon 端绝对路径, 远端 daemon 时不能用 Windows 路径)
# 不填: 容器内空, 进 openvscode 终端 git clone
# HOST_PROJECT_DIR=/opt/projects/my-next-app

# 代理 (按需, knodo 走云端可能需要)
# HTTP_PROXY=http://172.25.93.8:10808
# HTTPS_PROXY=http://172.25.93.8:10808
# NO_PROXY=localhost,127.0.0.1
