# =============================================================================
# 根 .gitignore
# 任何子目录的 .env / .env.* / *.env 都不入库 (腾讯云密钥等)
# =============================================================================

# 环境变量 / 密钥
.env
.env.*
*.env
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS 临时
*.tmp
*.bak
*.orig
*~

# Docker 资源
docker-compose.override.yml
